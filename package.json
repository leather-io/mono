{
  "name": "leather-mono",
  "author": "Leather Wallet",
  "description": "Leather wallet shared code",
  "version": "2.7.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:extension": "turbo run build --filter=!./apps/mobile --filter=!./apps/web",
    "build:mobile": "turbo run build --filter=!./apps/web --filter=!./apps/extension",
    "build:packages": "turbo run build --filter=!./apps/*",
    "build:watch": "turbo run build:watch",
    "build:web": "turbo run build --filter=!./apps/mobile --filter=!./apps/extension",
    "check:all": "turbo run check:all",
    "clean": "git clean -dfX",
    "dev": "turbo run build:watch",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "install:clean": "rm -rf \"**/node_modules\" && pnpm -r clean",
    "install:fresh": "pnpm install:clean && pnpm i",
    "install:nuke": "rm -rf pnpm-lock.yaml && pnpm install:fresh",
    "knip": "knip",
    "lint": "eslint --cache --max-warnings 0 && turbo run lint",
    "lint:deps": "pnpm dependency-cruiser .",
    "lint:filenames": "pnpm ls-lint",
    "lint:fix": "pnpm lint --fix",
    "prepare": "husky",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "test": "turbo run test",
    "test:coverage": "pnpm -r test:coverage",
    "test:e2e": "playwright test",
    "test:unit": "pnpm -r test:unit",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@babel/runtime": "7.26.0",
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@leather.io/eslint-config": "workspace:*",
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "@ls-lint/ls-lint": "2.2.3",
    "@playwright/test": "1.56.0",
    "@tanstack/eslint-plugin-query": "5.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/jest": "29.5.12",
    "@types/node": "24.0.8",
    "@vitest/coverage-v8": "2.1.5",
    "audit-ci": "6.6.1",
    "chalk": "5.3.0",
    "dependency-cruiser": "16.10.0",
    "dotenv": "16.4.5",
    "eslint": "9.28",
    "eslint-plugin-lingui": "0.10.1",
    "husky": "9.1.7",
    "lint-staged": "15.2.10",
    "prettier": "3.5.1",
    "syncpack": "13.0.0",
    "turbo": "2.5.8",
    "typescript": "5.8.3",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=22.15.0",
    "pnpm": ">=10.10.0",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "keywords": [],
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "pnpm": {
    "overrides": {
      "cross-spawn": "7.0.5",
      "@microsoft/api-extractor": "7.52.8",
      "@shopify/flash-list>tslib": "2.4.0",
      "levelup>semver": "5.7.2",
      "sha.js": "2.4.12",
      "sanity>tar-fs": "2.1.4",
      "prebuild-install>tar-fs": "2.1.4",
      "@expo/cli>@react-native-community/cli-server-api": "18.0.1",
      "glob": "11.1.0"
    },
    "packageExtensions": {
      "@expo/cli@*": {
