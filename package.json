          "metro-cache-key": "*",
          "expo-asset": "*",
          "metro": "*",
          "metro-transform-plugins": "*",
          "metro-source-map": "*",
          "metro-transform-worker": "*",
          "metro-minify-terser": "*",
          "@react-native/js-polyfills": "*"
        },
        "peerDependencies": {
