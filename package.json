      "@expo/metro-runtime@*": {
        "dependencies": {
          "react-native": "*",
          "url-parse": "*",
          "expo-constants": "*",
          "stacktrace-parser": "*"
        },
        "peerDependencies": {
          "react-native": "*"
        }
      },
      "expo-head@*": {
        "dependencies": {
          "url-parse": "*"
        }
      },
      "expo-router@*": {
        "dependencies": {
          "react-native": "*",
          "nanoid": "*",
          "url-parse": "*",
          "resolve-from": "*",
          "debug": "*",
          "@react-navigation/native-stack": "*",
          "@react-navigation/core": "*",
          "@expo/metro-runtime": "*",
          "expo-constants": "*",
          "escape-string-regexp": "*",
          "query-string": "7.1.3"
        }
      },
      "expo-linking@*": {
        "dependencies": {
          "expo-modules-core": "*"
        }
      },
      "expo-web-browser@*": {
        "dependencies": {
          "expo-modules-core": "*"
        }
      },
      "expo-font@*": {
        "dependencies": {
          "expo-modules-core": "*",
          "expo-constants": "*",
          "@expo/vector-icons": "*"
        }
      },
      "expo-splash-screen@*": {
        "dependencies": {
          "expo-modules-core": "*"
        }
      },
      "expo-constants@*": {
        "dependencies": {
          "expo-modules-core": "*"
        }
      },
      "expo@*": {
        "dependencies": {
          "@expo/metro-config": "*"
        }
      },
      "object-inspect@*": {
        "dependencies": {
          "util": "*"
        }
      },
      "@expo/vector-icons": {
        "dependencies": {
          "prop-types": "*"
        }
      },
      "react-native@*": {
        "peerDependencies": {
          "@react-native/assets-registry": "*"
        }
      },
      "expo-asset@*": {
        "dependencies": {
          "expo-modules-core": "*",
          "@expo/cli": "*"
        },
        "peerDependencies": {
          "@react-native/assets-registry": "*",
          "expo-font": "*"
        }
      },
      "expo-keep-awake@*": {
        "dependencies": {
          "expo-modules-core": "*"
        }
      },
      "expo-file-system": {
        "dependencies": {
          "expo-modules-core": "*"
        }
      }
    },
    "patchedDependencies": {
      "pofile@1.1.4": "patches/pofile@1.1.4.patch",
      "expo-secure-store@14.2.3": "patches/expo-secure-store@14.2.3.patch",
      "react-native-webview@13.14.1": "patches/react-native-webview@13.14.1.patch"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite3"
    ]
  }
