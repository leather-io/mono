{
  "extends": "../../packages/tsconfig-config/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["es2022", "DOM"],
    "module": "es2022",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "./dist",
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "typeRoots": ["./src/i18n/lingui.d.ts"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/scripts/injected-provider.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "index.d.ts"
  ]
}
