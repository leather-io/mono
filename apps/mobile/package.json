{
  "name": "@leather.io/mobile",
  "version": "2.115.2",
  "type": "module",
  "scripts": {
    "1password:env:dev": "op read \"op://leather-cli/env-content/dev\" > .env",
    "1password:env:prod": "op read \"op://leather-cli/env-content/prod\" > .env",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "build": "pnpm lingui",
    "check:cocoapods": "sh scripts/enforce-cocoapods-version.sh",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "ios": "expo run:ios",
    "ios:build": "expo run:ios --no-bundler",
    "knip": "knip --include files,exports,types,enumMembers,duplicates",
    "lingui": "pnpm run lingui:extract && pnpm run lingui:compile",
    "lingui:compile": "lingui compile --typescript --strict",
    "lingui:extract": "lingui extract --clean --overwrite",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "postinstall": "pnpm lingui:compile && if [ \"$PROVISION_MOBILE\" = \"true\" ]; then pnpm -w build:mobile; fi",
    "prebuild": "expo prebuild --clean",
    "preios": "pnpm run check:cocoapods",
    "start": "expo start",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "maestro test maestro/flows/*",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
