# Copy to `.env` (gitignored) and fill in what you want to personalise. Every
# value is optional: leave it blank and the default from src/constants.ts is
# used. Vite reads this at startup — restart `pnpm dev` after editing.
#
# The CONNECTED wallet's own addresses, public keys and xpubs are never
# configured here: buttons read them through `getAddresses` at click time.
# Never put a mnemonic or private key in this file.

# ── Network ──────────────────────────────────────────────────────────────────
# Which network the header starts on (mainnet, testnet4, signet, devnet,
# private, or your custom id below).
VITE_TEST_APP_DEFAULT_NETWORK=
# `private` is the wallet's custom-network slot, so what it means depends on
# what you registered under it: regtest (bcrt1…, the default) or testnet (tb1…,
# e.g. Hiro's hosted pox-5 testnet).
VITE_TEST_APP_PRIVATE_NETWORK_MODE=
# An extra network id to offer in the header, and its address flavour.
VITE_TEST_APP_CUSTOM_NETWORK_ID=
VITE_TEST_APP_CUSTOM_NETWORK_MODE=

# ── Recipients ───────────────────────────────────────────────────────────────
# BTC transfers default to your own address. Set these to send elsewhere.
VITE_TEST_APP_BTC_RECIPIENT=
VITE_TEST_APP_BTC_RECIPIENT_REGTEST=
# Stacks rejects transfers to self, so STX transfers go to a fixture address
# unless you set one.
VITE_TEST_APP_STX_RECIPIENT=

# ── Assets you hold ──────────────────────────────────────────────────────────
# SIP-10 token (`<contract>::<token>`) and SIP-9 NFT (`<contract>::<asset>` +
# token id) owned by the connected wallet, so token transfers can succeed.
VITE_TEST_APP_SIP10_ASSET=
VITE_TEST_APP_SIP9_ASSET=
VITE_TEST_APP_SIP9_ASSET_ID=

# ── Multisig co-signers ──────────────────────────────────────────────────────
# Comma-separated EXTENDED public keys of the OTHER signers — the shape the
# multisig dApp registers and the only shape bonds accept. Your own xpub is
# added automatically; the threshold is 2. Use the tpub list off mainnet.
VITE_TEST_APP_BTC_COSIGNER_XPUBS=
VITE_TEST_APP_BTC_COSIGNER_TPUBS=
# Stacks multisig takes raw compressed public keys, not xpubs. Order matters.
VITE_TEST_APP_STX_COSIGNER_PUBLIC_KEYS=
# Legacy bare-pubkey BTC descriptor, for the one button that still sends it.
VITE_TEST_APP_BTC_COSIGNER_PUBLIC_KEYS=

# ── Staking ──────────────────────────────────────────────────────────────────
# Contracts the staking buttons call. Defaults follow the web app's
# pox5-network-config per network; override for your own pool or devnet.
VITE_TEST_APP_POX5_CONTRACT=
VITE_TEST_APP_POX4_CONTRACT=
VITE_TEST_APP_SIGNER_MANAGER_CONTRACT=

# ── Bonds ────────────────────────────────────────────────────────────────────
# The counterparty of the bond hashlock branch, the preimage it must reveal
# (public here on purpose, so the exit can be exercised), and the timelock.
VITE_TEST_APP_BOND_COUNTERPARTY_PUBLIC_KEY=
VITE_TEST_APP_BOND_PREIMAGE=
VITE_TEST_APP_BOND_UNLOCK_HEIGHT=

# ── Real UTXOs ───────────────────────────────────────────────────────────────
# An Esplora API — a local regtest one, or a public testnet4 one. With it set,
# scenarios can spend the wallet's real coins, read the chain tip and broadcast.
VITE_TEST_APP_ESPLORA_URL=
