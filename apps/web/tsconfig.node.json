{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "panda.config.ts",
    "playwright.config.ts",
    "./scripts/**/*.ts",
    "**/*.styles.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
