{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": [
    ".dependency-cruiser-known-violations.json",
    ".dependency-cruiser.cjs",
    ".ls-lint.yml",
    ".prettierignore",
    ".prettierrc.js",
    "eslint.config.js",
    "knip.json",
    "tsconfig.json",
    "turbo.json"
  ],
  "tasks": {
    "build": {
      "outputs": [
        "dist/**",
        "dist-*/**",
        "build/**",
        "leather-styles/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "build:watch": {},
    "format": {},
    "format:check": {},
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint:fix": {},
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:coverage": {
      "outputs": [
        "coverage/**"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "check:all": {
      "dependsOn": [
        "build",
        "format",
        "typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
