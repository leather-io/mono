{
  "name": "@leather.io/tokens",
  "author": "Leather.io contact@leather.io",
  "description": "Shared design tokens",
  "version": "0.25.0",
  "license": "MIT",
  "homepage": "https://github.com/leather-io/mono/tree/dev/packages/tokens",
  "repository": {
    "type": "git",
    "url": "git@github.com:leather-io/mono.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "prepare": "pnpm build",
    "prepublish": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bugs": "https://github.com/leather-io/mono/issues",
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "tsdown": "0.16.5"
  },
  "keywords": [
    "leather",
    "leather wallet",
    "tokens"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  }
}
