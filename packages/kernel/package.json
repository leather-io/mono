{
  "name": "@leather.io/kernel",
  "author": "Leather.io contact@leather.io",
  "description": "Building blocks checked by property tests, for code that is hashed, signed or parsed",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/leather-io/mono/tree/dev/packages/kernel",
  "repository": {
    "type": "git",
    "url": "git@github.com:leather-io/mono.git",
    "directory": "packages/kernel"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepublish": "pnpm build",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bugs": "https://github.com/leather-io/mono/issues",
  "dependencies": {
    "micro-packed": "0.7.3"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "fast-check": "4.10.2",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "leather",
    "leather wallet",
    "property tests"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
