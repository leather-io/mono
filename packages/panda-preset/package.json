{
  "name": "@leather.io/panda-preset",
  "author": "Leather, LLC",
  "description": "Leather styles package",
  "version": "0.14.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "prepare": "pnpm build"
  },
  "exports": {
    ".": "./dist/preset.js"
  },
  "dependencies": {
    "@pandacss/dev": "0.53.6"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/tokens": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "tsdown": "0.16.5"
  },
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  }
}
