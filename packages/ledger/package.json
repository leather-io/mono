{
  "name": "@leather.io/ledger",
  "author": "Leather.io contact@leather.io",
  "description": "Platform-neutral Ledger device protocol helpers",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/leather-io/mono/tree/dev/packages/ledger",
  "repository": {
    "type": "git",
    "url": "git@github.com:leather-io/mono.git",
    "directory": "packages/ledger"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js",
    "./test-utils": "./dist/test-utils.js"
  },
  "bugs": "https://github.com/leather-io/mono/issues",
  "dependencies": {
    "@bitcoinerlab/descriptors-core": "3.1.7",
    "@leather.io/bitcoin": "workspace:*",
    "@leather.io/crypto": "workspace:*",
    "@leather.io/models": "workspace:*",
    "@leather.io/stacks": "workspace:*",
    "@leather.io/utils": "workspace:*",
    "@ledgerhq/device-management-kit": "1.9.0",
    "@ledgerhq/device-signer-kit-bitcoin": "1.3.3",
    "@noble/hashes": "1.5.0",
    "@stacks/common": "7.0.2",
    "@stacks/network": "7.0.2",
    "@stacks/transactions": "7.5.0",
    "@zondax/ledger-stacks": "2.0.0",
    "bitcoinjs-lib": "7.0.1",
    "compare-versions": "6.1.0",
    "remeda": "2.21.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "@scure/bip32": "1.6.2",
    "@scure/btc-signer": "1.6.0",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ledger",
    "leather",
    "leather wallet"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
