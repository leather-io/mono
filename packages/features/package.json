{
  "name": "@leather.io/features",
  "version": "1.1.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/tokens": "workspace:*",
    "@noble/hashes": "1.5.0",
    "react": "19.0.0"
  },
  "devDependencies": {
    "@leather.io/test-config": "workspace:*",
    "@types/react": "19.0.12",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist-web",
    "dist-native"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  }
}
