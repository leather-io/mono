{
  "name": "@leather.io/features",
  "version": "1.1.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch --onSuccess 'tsup --dts-only'",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@leather.io/constants": "workspace:*",
    "@leather.io/models": "workspace:*",
    "@leather.io/services": "workspace:*",
    "@leather.io/tokens": "workspace:*",
    "@leather.io/utils": "workspace:*",
    "@noble/hashes": "1.5.0",
    "dayjs": "1.11.13"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "prettier": "3.5.1",
    "tsup": "8.4.0",
    "typescript": "5.8.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@tanstack/react-query": "5.85.5",
    "react": "19.0.0"
  },
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  }
}
