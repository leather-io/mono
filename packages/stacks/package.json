{
  "name": "@leather.io/stacks",
  "author": "leather.io",
  "description": "Stacks package for Leather",
  "version": "1.22.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepublish": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "tsc --declaration --emitDeclarationOnly"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@leather.io/crypto": "workspace:*",
    "@leather.io/models": "workspace:*",
    "@leather.io/utils": "workspace:*",
    "@noble/hashes": "1.5.0",
    "@scure/bip32": "1.6.2",
    "@stacks/common": "7.0.2",
    "@stacks/encryption": "7.0.2",
    "@stacks/network": "7.0.2",
    "@stacks/transactions": "7.5.0",
    "bignumber.js": "9.1.2",
    "c32check": "2.0.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
