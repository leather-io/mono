{
  "name": "@leather.io/rpc",
  "author": "leather-wallet",
  "description": "RPC types package for Leather",
  "version": "2.21.16",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepublish": "pnpm build",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "tsc --declaration --emitDeclarationOnly"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "dependencies": {
    "@leather.io/models": "workspace:*",
    "@leather.io/stacks": "workspace:*",
    "@leather.io/utils": "workspace:*",
    "@scure/btc-signer": "1.6.0",
    "@stacks/network": "7.0.2",
    "@stacks/transactions": "7.0.5",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
