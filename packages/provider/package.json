{
  "name": "@leather.io/provider",
  "author": "leather-wallet",
  "description": "LeatherProvider package for Leather",
  "version": "1.6.28",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown && node scripts/prepare-script.js",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepublish": "pnpm build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "tsc --declaration --emitDeclarationOnly"
  },
  "exports": {
    ".": "./dist/index.js",
    "./mobile": "./dist/injected-provider.js"
  },
  "dependencies": {
    "@leather.io/rpc": "workspace:*",
    "@stacks/connect": "7.4.0",
    "@stacks/connect-jwt": "npm:@stacks/connect@7.4.0"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
