{
  "name": "@leather.io/sdk",
  "author": "leather.io",
  "description": "Leather SDK",
  "version": "1.5.41",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --no-clean --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "prepublish": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "tsc --declaration --emitDeclarationOnly"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "dependencies": {
    "@leather.io/models": "workspace:*",
    "@leather.io/rpc": "workspace:*",
    "ts-expect": "1.3.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "expect-type": "1.2.0",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
