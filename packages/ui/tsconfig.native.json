{
  "extends": ["@leather.io/tsconfig-config/tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["ESNext", "DOM"],
    "baseUrl": "./src",
    "rootDir": "./src",
    "outDir": "./dist-native"
  },
  "include": [
    "src/**/*.native.ts",
    "src/**/*.native.tsx",
    "src/native.ts",
    "src/theme-native/**/*",
    "src/.storybook-native/**/*",
    "src/**/*.shared.tsx",
    "src/**/*.shared.ts",
    "src/**/*.shared.spec.ts",
    "src/global.d.ts"
  ]
}
