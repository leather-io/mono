{
  "name": "@leather.io/ui",
  "version": "1.119.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "sh build-conditional.sh",
    "build:native": "tsdown --config tsdown.config.native.ts",
    "build:native:watch": "tsdown --watch --config tsdown.config.native.ts",
    "build:watch": "concurrently \"pnpm build:native:watch\" \"pnpm build:web:watch\" ",
    "build:web": "panda && tsdown --config tsdown.config.web.ts",
    "build:web:watch": "concurrently \"pnpm panda --watch\" \"tsdown --watch --config tsdown.config.web.ts\" ",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --project ./tsconfig.native.json && tsc --noEmit --project ./tsconfig.web.json"
  },
  "exports": {
    ".": "./dist-web/exports.web.js",
    "./styles": "./dist-web/styles.css",
    "./native": "./dist-native/native.js",
    "./assets/*": "./src/assets/*"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.10",
    "@leather.io/tokens": "workspace:*",
    "@leather.io/utils": "workspace:*",
    "@rnx-kit/metro-resolver-symlinks": "0.2.3",
    "@shopify/flash-list": "2.0.2",
    "@shopify/restyle": "2.4.5",
    "dompurify": "3.2.4",
    "expo": "57.0.24",
    "expo-blur": "57.0.3",
    "expo-haptics": "57.0.3",
    "expo-image": "57.0.5",
    "expo-linear-gradient": "57.0.2",
    "expo-squircle-view": "1.1.0",
    "framer-motion": "12.23.22",
    "prism-react-renderer": "2.4.1",
    "prismjs": "1.30.0",
    "radix-ui": "1.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "remeda": "2.21.2",
    "use-events": "1.4.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/runtime": "7.26.0",
    "@leather.io/features": "workspace:*",
    "@leather.io/models": "workspace:*",
    "@leather.io/panda-preset": "workspace:*",
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "@leather.io/tsconfig-config": "workspace:*",
    "@pandacss/dev": "1.7.1",
    "@svgr/rollup": "8.1.0",
    "@testing-library/react": "16.3.0",
    "@types/prismjs": "1.26.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-preset-expo": "57.0.12",
    "concurrently": "8.2.2",
    "happy-dom": "20.0.11",
    "prettier": "3.5.1",
    "react-native-svg-transformer": "1.5.3",
    "rollup-plugin-copy": "3.5.0",
    "tsdown": "0.16.5",
    "tslib": "2.6.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist-web",
    "dist-native"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  }
}
