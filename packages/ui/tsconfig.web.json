{
  "extends": ["@leather.io/tsconfig-config/tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "baseUrl": "./src",
    "rootDir": "./src",
    "outDir": "./dist-web",
    "paths": {
      "leather-styles/*": ["../leather-styles/*"]
    }
  },
  "include": [
    "src/**/*.web.ts",
    "src/**/*.web.tsx",
    "src/web.exports.ts",
    "src/.storybook-web/**/*",
    "src/**/*.shared.tsx",
    "src/**/*.shared.ts",
    "src/**/*.shared.spec.ts",
    "src/global.d.ts",
    "leather-styles/"
  ]
}
