{
  "name": "@leather.io/analytics",
  "author": "Leather.io contact@leather.io",
  "description": "Analytics package for Leather using Mixpanel",
  "version": "3.17.0",
  "license": "MIT",
  "homepage": "https://github.com/leather.io/mono/tree/dev/packages/analytics",
  "repository": {
    "type": "git",
    "url": "git@github.com:leather.io/mono.git",
    "directory": "packages/analytics"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../../.prettierignore",
    "lint": "eslint --cache --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@leather.io/models": "workspace:*",
    "@leather.io/prettier-config": "workspace:*",
    "@leather.io/test-config": "workspace:*",
    "@types/node": "24.0.8",
    "concurrently": "8.2.2",
    "prettier": "3.5.1",
    "tsdown": "0.16.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "bitcoin",
    "leather",
    "leather wallet"
  ],
  "prettier": "@leather.io/prettier-config",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts"
}
