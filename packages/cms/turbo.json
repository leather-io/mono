{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["$TURBO_EXTENDS$", "src/generated/**"]
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "build"]
    }
  }
}
